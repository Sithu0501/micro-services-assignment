# ==============================================================================
# RideLink Microservices - Central Environment Variables Template
# Copy this file to .env or set these in your local environment.
# DO NOT commit real secrets, credentials, or actual connection strings to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Account Service (Port 8081)
# Database: ridelink_account_db
# ------------------------------------------------------------------------------
ACCOUNT_SERVICE_PORT=8081
ACCOUNT_MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ridelink_account_db?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 2. Driver & Vehicle Service (Port 8082)
# Database: ridelink_driver_db
# ------------------------------------------------------------------------------
DRIVER_SERVICE_PORT=8082
DRIVER_MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ridelink_driver_db?retryWrites=true&w=majority
ACCOUNT_SERVICE_URL=http://localhost:8081

# ------------------------------------------------------------------------------
# 3. Ride Management Service (Port 8083)
# Database: ridelink_ride_db
# ------------------------------------------------------------------------------
RIDE_SERVICE_PORT=8083
RIDE_MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ridelink_ride_db?retryWrites=true&w=majority
# Downstream service URLs for REST communication
DRIVER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8084

# ------------------------------------------------------------------------------
# 4. Fare & Payment Service (Port 8084)
# Database: ridelink_payment_db
# ------------------------------------------------------------------------------
PAYMENT_SERVICE_PORT=8084
PAYMENT_MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ridelink_payment_db?retryWrites=true&w=majority
RIDE_SERVICE_URL=http://localhost:8083
