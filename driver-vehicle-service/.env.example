# Server Configuration
PORT=8082

# MongoDB connection (database: ridelink_driver_db)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ridelink_driver_db?retryWrites=true&w=majority

# JWT Authentication (HMAC-SHA256, minimum 32 characters). MUST be identical in all four services.
JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
JWT_EXPIRATION=86400000
