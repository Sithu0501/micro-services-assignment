# Server Configuration
PORT=8083

# MongoDB connection (database: ridelink_ride_db)
RIDE_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ridelink_ride_db?retryWrites=true&w=majority

# Downstream microservice base URLs (REST)
ACCOUNT_SERVICE_URL=http://localhost:8081
DRIVER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8084

# JWT Authentication (HMAC-SHA256, minimum 32 characters). MUST be identical in all four services.
JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
