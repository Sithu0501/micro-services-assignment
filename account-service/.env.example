# Server Configuration
PORT=8081

# MongoDB connection (database: ridelink_account_db)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ridelink_account_db?retryWrites=true&w=majority

# JWT Authentication (HMAC-SHA256, minimum 32 characters). MUST be identical in all four services.
JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
JWT_EXPIRATION=86400000

# Admin bootstrap (the admin account is only seeded when ADMIN_PASSWORD is set)
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@ridelink.com
ADMIN_PASSWORD=<choose-a-strong-password>
ADMIN_FULL_NAME=RideLink Admin
ADMIN_PHONE=+94770000001
