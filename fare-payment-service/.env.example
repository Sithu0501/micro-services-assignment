# Server Configuration
PORT=8084

# MongoDB connection (database: ridelink_payment_db)
PAYMENT_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ridelink_payment_db?retryWrites=true&w=majority
PAYMENT_DB_NAME=ridelink_payment_db

# Ride Management Service base URL (used to verify a ride is COMPLETED before payment)
RIDE_SERVICE_URL=http://localhost:8083

# JWT Authentication (HMAC-SHA256, minimum 32 characters). MUST be identical in all four services.
JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
